<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Group to center all visual components in safe area -->
    <group
        android:translateX="0"
        android:translateY="0">

        <!-- 1. LEFT LEAF (Gradient Green) -->
        <path
            android:pathData="M54,42C50,33 41,31 36,36C41,41 50,42 54,42Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="36"
                    android:startY="36"
                    android:endX="54"
                    android:endY="42"
                    android:type="linear">
                    <item android:color="#8CE23B" android:offset="0.0" />
                    <item android:color="#137C3C" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>
        <path
            android:strokeColor="#A6EE5C"
            android:strokeWidth="0.8"
            android:strokeLineCap="round"
            android:pathData="M54,42Q46,38 36,36" />

        <!-- 2. RIGHT LEAF (Gradient Green) -->
        <path
            android:pathData="M54,42C58,33 67,31 72,36C67,41 58,42 54,42Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="72"
                    android:startY="36"
                    android:endX="54"
                    android:endY="42"
                    android:type="linear">
                    <item android:color="#8CE23B" android:offset="0.0" />
                    <item android:color="#137C3C" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>
        <path
            android:strokeColor="#A6EE5C"
            android:strokeWidth="0.8"
            android:strokeLineCap="round"
            android:pathData="M54,42Q62,38 72,36" />

        <!-- 3. TOP CREDIT/NOTES PAPERS (Slightly showing behind top of wallet) -->
        <path
            android:pathData="M38,42 L38,36C38,34.5 39.5,33 41,33 L67,33C68.5,33 70,34.5 70,36 L70,42 Z"
            android:fillColor="#0D5528" />
        <path
            android:pathData="M42,42 L42,39C42,38 43,37 44,37 L64,37C65,37 66,38 66,39 L66,42 Z"
            android:fillColor="#E1F7E8" />

        <!-- 4. WALLET BODY (Gradient from light green to rich dark green) -->
        <path
            android:pathData="M35,42h38c3.3,0 6,2.7 6,6v28c0,3.3 -2.7,6 -6,6h-38c-3.3,0 -6,-2.7 -6,-6v-28c0,-3.3 2.7,-6 3.5,-6Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="54"
                    android:startY="42"
                    android:endX="54"
                    android:endY="82"
                    android:type="linear">
                    <item android:color="#2ECC71" android:offset="0.0" />
                    <item android:color="#137C3C" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- 5. STITCHING (Solid fine inset line) -->
        <path
            android:strokeColor="#C5EAD0"
            android:strokeWidth="0.6"
            android:pathData="M37,45h34c2,0 3,1 3,3v22c0,2 -1,3 -3,3h-34c-2,0 -3,-1 -3,-3v-22c0,-2 2,-3 3,-3Z" />

        <!-- 6. CLASP ON RIGHT (Navy leather) -->
        <path
            android:pathData="M72,52h7c2.5,0 4.5,2 4.5,4.5v11c0,2.5 -2,4.5 -4.5,4.5h-7Z"
            android:fillColor="#0D2545" />

        <!-- Clasp snap concentric circles -->
        <path
            android:pathData="M77.5,64m-2.5,0a2.5,2.5 0 1,1 5,0a2.5,2.5 0 1,1 -5,0"
            android:fillColor="#FFFFFF" />
        <path
            android:pathData="M77.5,64m-1,0a1,1 0 1,1 2,0a1,1 0 1,1 -2,0"
            android:fillColor="#137C3C" />

        <!-- 7. INDIAN RUPEE (₹) SYMBOL (Centered inside wallet body) -->
        <!-- Vertical stem -->
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="2.2"
            android:strokeLineCap="round"
            android:pathData="M52,54 L52,67" />
        <!-- Standard upper loop -->
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="2.2"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M52,54 C57.5,54 57.5,60.5 52,60.5" />
        <!-- Diagonal foot slash -->
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="2.2"
            android:strokeLineCap="round"
            android:pathData="M51.5,60 L57,69" />
        <!-- Top Horizontal bar -->
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="2.1"
            android:strokeLineCap="round"
            android:pathData="M47,54 L57.5,54" />
        <!-- Middle horizontal bar -->
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="2.1"
            android:strokeLineCap="round"
            android:pathData="M48,57.5 L55.5,57.5" />

    </group>
</vector>
